# 找一款「入口能被 node 执行」的 pnpm 11（上游 package-target 用 `node $npm_execpath` 复起 pnpm）。
_dsh_pnpm_usable() {
  local pnpm=${1:-}
  [[ -n $pnpm && -x $pnpm ]] || return 1
  [[ "$("$pnpm" --version 2>/dev/null)" == 11.* ]] || return 1
  local probe rc=0
  probe="$(mktemp -d)"
  cat >"$probe/package.json" <<'JSON'
{ "name": "pnpm-entry-probe", "private": true, "packageManager": "pnpm@11.28.5",
  "scripts": { "probe": "node probe.cjs" } }
JSON
  cat >"$probe/probe.cjs" <<'JS'
require('node:child_process').execFileSync(process.execPath, [process.env.npm_execpath, '--version'], { stdio: 'ignore' })
JS
  ( cd "$probe" && "$pnpm" run --silent probe >/dev/null 2>&1 ) || rc=$?
  rm -rf "$probe"
  return "$rc"
}

prepare() {
  cd "$srcdir"
  # makepkg 失败重跑时，已修改的旧文件会被重新解包覆盖，但补丁新增的文件残留，导致同一
  # 补丁正向/反向都打不上。直接从源码包重建工作树，prepare() 就可重复执行。
  rm -rf "$_srcdirname"
  bsdtar -xf "$srcdir/$_srcdirname.tar.gz" -C "$srcdir"
  cd "$_srcdirname"
  local p
  for p in "$srcdir"/0*.patch; do
    msg2 "applying $(basename "$p")"
    patch -Np1 --no-backup-if-mismatch -i "$p" || return 1
  done
}

build() {
  cd "$srcdir/$_srcdirname"
  export PATH="/usr/bin:$PATH"
  # 构建期 Host 会写数据目录，绝不能落到用户真实的 ~/.dsh。
  export DSH_HOME="$srcdir/dsh-home"
  mkdir -p "$DSH_HOME"
  # release 源码包没有 .git：显式给出提交与 dirty 状态（dirty=1 是事实，构建打了补丁）。
  export DSH_CLIENT_COMMIT_HASH="$_commit"
  export DSH_DESKTOP_BUILD_COMMIT="$_commit"
  export DSH_DESKTOP_BUILD_DIRTY=1

  local pnpm=''
  if _dsh_pnpm_usable "$(command -v pnpm 2>/dev/null)"; then
    pnpm="$(command -v pnpm)"
  elif _dsh_pnpm_usable "$HOME/.local/share/dsh-pnpm-11/node_modules/.bin/pnpm"; then
    pnpm="$HOME/.local/share/dsh-pnpm-11/node_modules/.bin/pnpm"
  else
    error "需要 pnpm 11.x 且入口可被 node 执行（npm i --prefix ~/.local/share/dsh-pnpm-11 pnpm@11.28.5）"
    return 1
  fi
  msg2 "pnpm: $pnpm ($("$pnpm" --version))"

  # Linux 发布设置：APP_ID 必填；内部 pnpm 走镜像源（可被环境覆盖）。
  cat >apps/desktop/.env.linux <<EOF
DSH_DESKTOP_APP_ID=com.deepseek.dsh
DSH_DESKTOP_NPM_REGISTRY=${DSH_DESKTOP_NPM_REGISTRY:-https://registry.npmmirror.com}
EOF

  "$pnpm" install --frozen-lockfile
  # 预热 Electron 二进制（~117MB），让下载失败发生在构建前。
  node apps/desktop/node_modules/electron/install.js

  if [[ -n ${DSH_DESKTOP_LINUX_DOWNLOAD_CACHE:-} ]]; then
    install -d apps/desktop/.desktop-build/downloads
    cp -an "$DSH_DESKTOP_LINUX_DOWNLOAD_CACHE/." apps/desktop/.desktop-build/downloads/
  fi

  "$pnpm" --dir apps/desktop run package:linux:x64:dir
}

package() {
  cd "$srcdir/$_srcdirname"
  local unpacked='apps/desktop/.desktop-build/targets/linux-x64/unsigned-artifacts/linux-unpacked'
  if [[ ! -d $unpacked ]]; then
    error "找不到 $unpacked（electron-builder 输出路径可能变了）"
    return 1
  fi
  install -d "$pkgdir/opt/deepseek-harness-desktop-wayland"
  cp -a "$unpacked"/. "$pkgdir/opt/deepseek-harness-desktop-wayland/"

  install -d "$pkgdir/usr/bin"
  install -Dm755 "$srcdir/deepseek-harness-wayland" "$pkgdir/usr/bin/deepseek-harness-wayland"
  ln -s /usr/bin/deepseek-harness-wayland "$pkgdir/usr/bin/deepseek-harness"

  install -Dm644 "$srcdir/deepseek-harness.desktop" "$pkgdir/usr/share/applications/deepseek-harness.desktop"
  install -Dm644 "$srcdir/deepseek-harness-desktop.service" \
    "$pkgdir/usr/lib/systemd/user/deepseek-harness-desktop.service"

  # 应用图标：安装打包产物自带 PNG + 仓库内的 SVG（hicolor scalable）。
  if [[ -f $unpacked/resources/icon.png ]]; then
    install -Dm644 "$unpacked/resources/icon.png" \
      "$pkgdir/usr/share/icons/hicolor/512x512/apps/deepseek-harness.png"
  fi
  install -Dm644 "$srcdir/deepseek-harness.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/deepseek-harness.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # 上游 fpm 目标会在 linux-unpacked 里写 AppArmor profile；--dir 构建没有该文件，这里补一份
  # （仓库里的模板已按新安装前缀写好）。
  install -Dm644 "$srcdir/deepseek-harness.apparmor" "$pkgdir/etc/apparmor.d/deepseek-harness"

  # chrome-sandbox 的基本权限由包内容给出；setuid 位由 .install 按内核 userns 能力决定
  # （与上游 deb/rpm 的 postinst 一致）。
  chmod 0755 "$pkgdir/opt/deepseek-harness-desktop-wayland/chrome-sandbox"
}

